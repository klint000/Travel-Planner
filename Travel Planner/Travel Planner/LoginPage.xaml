<Window x:Class="Travel_Planner.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Travel Planner - Вход"
        Height="620"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid Margin="24">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24">
            <StackPanel>
                <Image Source="Assets/logo.png" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                <TextBlock Text="Вход в систему" Style="{StaticResource HeaderTextStyle}"/>

                <TextBlock Text="Логин или Email" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="LoginTextBox" Height="40"/>

                <TextBlock Text="Пароль" Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox" Height="40"/>

                <Button Content="Войти" Height="44" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click"/>

                <Button Content="Нет аккаунта? Зарегистрироваться"
                        Style="{StaticResource LinkButtonStyle}"
                        Click="OpenRegistrationButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
