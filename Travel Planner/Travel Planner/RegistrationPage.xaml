<Window x:Class="Travel_Planner.RegistrationPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Travel Planner - Регистрация"
        Height="850"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid Margin="24">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24">
            <StackPanel>
                <Image Source="Assets/logo.png" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                <TextBlock Text="Регистрация" Style="{StaticResource HeaderTextStyle}"/>

                <TextBlock Text="ФИО" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="FullNameTextBox" Height="40"/>

                <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="EmailTextBox" Height="40"/>

                <TextBlock Text="Логин" Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="UsernameTextBox" Height="40"/>

                <TextBlock Text="Пароль" Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="PasswordBox" Height="40"/>

                <TextBlock Text="Подтверждение пароля" Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="40"/>

                <Button Content="Зарегистрироваться" Height="44" Style="{StaticResource PrimaryButtonStyle}" Click="RegisterButton_Click"/>
                <Button Content="Назад ко входу" Style="{StaticResource LinkButtonStyle}" Click="BackToLoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
